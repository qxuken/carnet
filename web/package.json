{
  "name": "carnet-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "description": "Carnet's notes in a browser: read, write, search, tick, offline (docs/SYNC.md §8)",
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/wasm.sh",
    "dev": "vite",
    "build": "sh scripts/wasm.sh && vite build && sh scripts/compress.sh",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "jsqr": "1.4.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
